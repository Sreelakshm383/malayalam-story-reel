 "subs": [
  {
   "id": "l01",
   "speaker": "amma",
   "start": 6.7,
   "end": 10.068,
   "ml": "മീരേ, നീ നാളെ എവിടെയെങ്കിലും പോകുന്നുണ്ടോ?",
   "en": "Meera, are you going somewhere tomorrow?"
  },
  {
   "id": "l02",
   "speaker": "meera",
   "start": 10.968,
   "end": 12.43,
   "ml": "എന്താ അമ്മേ?",
   "en": "Why, Amma?"
  },
  {
   "id": "l03",
   "speaker": "amma",
   "start": 13.23,
   "end": 19.815,
   "ml": "അല്ല, രാവിലെ മുതൽ നിന്റെ ഫോൺ വിളി കേൾക്കുന്നുണ്ടല്ലോ. എന്തെങ്കിലും പ്രശ്നമുണ്ടോന്ന് ചോദിച്ചതാ.",
   "en": "It's just... I've heard you on the phone since morning. I was asking if something is wrong."
  },
  {
   "id": "l04",
   "speaker": "meera",
   "start": 20.715,
   "end": 25.551,
   "ml": "പ്രശ്നമൊന്നുമില്ല അമ്മേ. ചില കാര്യങ്ങൾ ശരിയാക്കാനുണ്ട്.",
   "en": "Nothing's wrong, Amma. There are just a few things I need to sort out."
  },
  {
   "id": "l05",
   "speaker": "achan",
   "start": 26.951,
   "end": 31.265,
   "ml": "എന്ത് കാര്യമാണ്? വീട്ടിൽ പറയാൻ പറ്റാത്ത എന്തെങ്കിലും ഉണ്ടോ?",
   "en": "What things? Is there something you can't tell us at home?"
  },
  {
   "id": "l06",
   "speaker": "meera",
   "start": 32.265,
   "end": 38.565,
   "ml": "പറയാൻ പറ്റാത്തതല്ല അച്ഛാ... പറഞ്ഞിട്ട് മനസ്സിലാക്കാൻ ആരും തയ്യാറല്ലാത്തതാണ്.",
   "en": "It's not that I can't tell you, Achan... it's that no one is ready to understand."
  },
  {
   "id": "l07",
   "speaker": "appu",
   "start": 42.265,
   "end": 44.373,
   "ml": "ചേച്ചി, നീ വീണ്ടും പോകുവാണോ?",
   "en": "Chechi, are you leaving again?"
  },
  {
   "id": "l08",
   "speaker": "meera",
   "start": 45.173,
   "end": 46.203,
   "ml": "എവിടേക്ക്?",
   "en": "Where?"
  },
  {
   "id": "l09",
   "speaker": "appu",
   "start": 46.903,
   "end": 49.772,
   "ml": "പണ്ടത്തെപ്പോലെ... ഈ വീട്ടിൽ നിന്ന്.",
   "en": "Like before... from this house."
  },
  {
   "id": "l10",
   "speaker": "achan",
   "start": 53.472,
   "end": 58.57,
   "ml": "നാളെ രാവിലെ നമ്മൾ സംസാരിക്കണം. ഒരു കാര്യം നിന്നോട് പറയാനുണ്ട്.",
   "en": "We need to talk tomorrow morning. There's something I have to tell you."
  },
  {
   "id": "l11",
   "speaker": "meera",
   "start": 59.37,
   "end": 60.736,
   "ml": "എന്താ അച്ഛാ?",
   "en": "What is it, Achan?"
  },
  {
   "id": "l12",
   "speaker": "achan",
   "start": 61.836,
   "end": 63.602,
   "ml": "ഈ വീടിനെക്കുറിച്ചാണ്.",
   "en": "It's about this house."
  }
 ],
